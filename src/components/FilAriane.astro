---
// Fil d'Ariane visible. Le JSON-LD BreadcrumbList correspondant est passé
// séparément à BaseLayout via extraSchemas (voir src/lib/schemas.ts) : c'est
// la page qui le construit, pour éviter deux sources de vérité.
export interface Props {
  /** Du plus général au plus précis. Le dernier élément est la page courante. */
  items: { nom: string; url?: string }[];
}
const { items } = Astro.props;
---
<nav class="ariane" aria-label="Fil d'Ariane">
  <div class="conteneur">
    <ol>
      <li><a href="/">Accueil</a></li>
      {items.map((item, i) => (
        <li>
          {item.url && i < items.length - 1
            ? <a href={item.url}>{item.nom}</a>
            : <span aria-current="page">{item.nom}</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .ariane {
    background: var(--gris-50);
    border-bottom: 1px solid var(--gris-100);
    font-size: 0.85rem;
  }
  .ariane ol {
    list-style: none;
    margin: 0;
    padding: 0.7rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ariane li + li::before {
    content: '›';
    margin-right: 0.4rem;
    color: var(--gris-500);
  }
  .ariane a { color: var(--gris-700); text-decoration: none; }
  .ariane a:hover { color: var(--rouge); text-decoration: underline; }
  .ariane [aria-current='page'] { color: var(--bleu); font-weight: 600; }
</style>
