---
// Carrousel d'avis Google — scroll-snap natif + flèches, sans dépendance.
// Consigne client : étoiles + logo Google dans chaque card, PAS d'initiales
// dans un cercle.
//
// Props :
//   tag   — remonte en tête les avis portant ce tag (ex. "nettoyage")
//   lieu  — complément de lieu dans le titre (ex. "dans le Loiret")
//   ordre — décale la rotation pour varier l'ordre d'une page à l'autre
//   limite— n'affiche que les N premiers avis
//   avisIndex — sélection explicite d'avis par index (prioritaire sur tag/ordre),
//               pour que deux pages villes n'affichent jamais les mêmes
import reviews from '../data/reviews.json';

export interface Props {
  tag?: string;
  lieu?: string;
  ordre?: number;
  limite?: number;
  titre?: string;
  /** Indices d'avis à afficher, dans l'ordre. Prioritaire sur tag/ordre/limite. */
  avisIndex?: number[];
}
const {
  tag,
  lieu = "dans le Sud de l'Essonne",
  ordre = 0,
  limite,
  titre,
  avisIndex,
} = Astro.props;

const base = reviews.avis;
const n = base.length;
const decalage = ((ordre % n) + n) % n;
const avisDecales = decalage ? [...base.slice(decalage), ...base.slice(0, decalage)] : base;

const avisTries = tag
  ? [...avisDecales].sort((a, b) => {
      const aM = (a.tags || []).includes(tag) ? 0 : 1;
      const bM = (b.tags || []).includes(tag) ? 0 : 1;
      return aM - bM;
    })
  : avisDecales;

const avis = avisIndex?.length
  ? avisIndex.map((i) => base[i]).filter(Boolean)
  : limite
    ? avisTries.slice(0, limite)
    : avisTries;
---
<section class="section section--gris avis-carrousel">
  <div class="conteneur">
    <div class="entete-section">
      <h2>{titre || `Les avis de mes clients ${lieu}`}</h2>

      <p class="note-google">
        <span class="avis__etoiles" aria-hidden="true">★★★★★</span>
        <strong>{reviews.note.toLocaleString('fr-FR')}/5</strong> · {reviews.nombre} avis Google
        {reviews.urlFiche && (
          <>
            {' · '}<a href={reviews.urlFiche} rel="noopener nofollow" target="_blank">Voir tous les avis sur Google</a>
          </>
        )}
      </p>
    </div>

    <div class="carrousel">
      <button class="carrousel__fleche carrousel__fleche--prec" type="button" aria-label="Avis précédents">
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <ul class="carrousel__piste" aria-label="Avis de clients">
        {avis.map((a) => (
          <li class="carte avis carrousel__item">
            <div class="avis__entete">
              <div class="avis__identite">
                <span class="avis__nom">{a.auteur}</span>
                <span class="avis__date">
                  {a.date}{a.ville ? ` · ${a.ville}` : ''}
                </span>
              </div>
              <!-- Logo Google (SVG inline, 4 couleurs officielles) -->
              <svg class="avis__google" viewBox="0 0 24 24" role="img" aria-label="Avis publié sur Google">
                <path fill="#4285F4" d="M23.5 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.87c2.27-2.09 3.56-5.17 3.56-8.87z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.87-3a7.2 7.2 0 0 1-10.72-3.78H1.35v3.09A11.99 11.99 0 0 0 12 24z"/>
                <path fill="#FBBC05" d="M5.35 14.31a7.2 7.2 0 0 1 0-4.6V6.62H1.35a12 12 0 0 0 0 10.77l4-3.08z"/>
                <path fill="#EA4335" d="M12 4.77c1.77 0 3.35.61 4.6 1.8l3.43-3.43C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.35 6.62l4 3.09A7.2 7.2 0 0 1 12 4.77z"/>
              </svg>
            </div>

            <span class="avis__etoiles" aria-label={`${a.note} étoiles sur 5`}>
              {'★'.repeat(a.note)}{'☆'.repeat(5 - a.note)}
            </span>

            <p>{a.texte}</p>
          </li>
        ))}
      </ul>

      <button class="carrousel__fleche carrousel__fleche--suiv" type="button" aria-label="Avis suivants">
        <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .carrousel {
    position: relative;
    margin-top: 2rem;
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }
  .carrousel__piste {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.25rem 1.2rem;
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    flex: 1;
  }
  .carrousel__item {
    flex: 0 0 min(340px, 82vw);
    scroll-snap-align: start;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-radius: var(--rayon);
  }
  .carrousel__item:hover { transform: none; }
  .carrousel__item p { font-size: 0.94rem; color: var(--gris-700); margin: 0; }

  .avis__entete {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .avis__identite { display: flex; flex-direction: column; }
  .avis__nom { font-weight: 700; color: var(--bleu); }
  .avis__date { font-size: 0.82rem; color: var(--gris-500); }
  .avis__google { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; }
  .avis__etoiles { color: var(--etoile); letter-spacing: 0.08em; font-size: 1.05rem; }

  /* En-tête : voir le motif partagé .entete-section dans global.css.
     Un seul titre, aucun sur-titre — pas d'eyebrow sur ce site. */
  .note-google { color: var(--gris-700); margin-top: 1.1rem; font-size: 1.02rem; }
  .note-google strong { color: var(--bleu); font-size: 1.15rem; }

  .carrousel__piste::-webkit-scrollbar { height: 6px; }
  .carrousel__piste::-webkit-scrollbar-thumb { background: var(--gris-200); border-radius: 3px; }
  .carrousel__piste { scrollbar-width: thin; scrollbar-color: var(--gris-200) transparent; }

  .carrousel__fleche {
    align-self: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--gris-200);
    background: var(--blanc);
    color: var(--bleu);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--ombre);
    transition: background var(--transition), color var(--transition);
  }
  .carrousel__fleche:hover { background: var(--rouge); color: var(--blanc); border-color: var(--rouge); }
  .carrousel__fleche .icone { width: 1.3rem; height: 1.3rem; }

  @media (max-width: 700px) {
    .carrousel__fleche { display: none; }
  }
</style>

<script>
  document.querySelectorAll('.avis-carrousel .carrousel').forEach((c) => {
    const piste = c.querySelector('.carrousel__piste');
    if (!piste) return;
    const pas = () => {
      const item = piste.querySelector('.carrousel__item');
      return item ? item.getBoundingClientRect().width + 20 : 360;
    };
    c.querySelector('.carrousel__fleche--prec')?.addEventListener('click', () => piste.scrollBy({ left: -pas(), behavior: 'smooth' }));
    c.querySelector('.carrousel__fleche--suiv')?.addEventListener('click', () => piste.scrollBy({ left: pas(), behavior: 'smooth' }));
  });
</script>
