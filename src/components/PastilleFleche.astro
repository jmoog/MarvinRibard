---
// Flèche dans une pastille ronde, utilisée dans TOUS les boutons de devis.
// Le fond de la pastille s'adapte à la variante de bouton (voir .btn__pastille
// dans global.css) et la flèche suit la couleur du texte.
export interface Props { class?: string }
const { class: classe = '' } = Astro.props;
---
<span class={`btn__pastille ${classe}`.trim()} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h12.5" />
    <path d="m11.5 5.5 7 6.5-7 6.5" />
  </svg>
</span>
