---
// Barre d'appel flottante, visible sur mobile uniquement après un début de
// scroll. Un artisan se contacte au téléphone : c'est le premier levier de
// conversion du site. Le bouton WhatsApp offre une alternative sans appel,
// pratique pour envoyer des photos de la toiture avant même le premier contact.
import ent from '../data/entreprise.json';
import IconeMobile from './IconeMobile.astro';
import IconeWhatsapp from './IconeWhatsapp.astro';
import PastilleFleche from './PastilleFleche.astro';

const messageWhatsapp = 'Bonjour, je souhaite un devis pour des travaux de couverture.';
const lienWhatsapp = `https://wa.me/${ent.telephoneUri.replace('+', '')}?text=${encodeURIComponent(messageWhatsapp)}`;
---
<div class="flottant" data-flottant>
  <a href={`tel:${ent.telephoneLien}`} class="flottant__btn flottant__btn--tel">
    <IconeMobile />
    <span>Appeler</span>
  </a>
  <a
    href={lienWhatsapp}
    class="flottant__btn flottant__btn--whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter par WhatsApp"
  >
    <IconeWhatsapp class="icone icone--whatsapp" />
    <span>WhatsApp</span>
  </a>
  <a href="/contact/" class="flottant__btn flottant__btn--devis">
    <span>Devis gratuit</span>
    <PastilleFleche />
  </a>
</div>

<style>
  .flottant {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 -4px 18px rgba(18, 41, 76, 0.22);
  }
  .flottant--visible { transform: translateY(0); }
  .flottant__btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: 0.9em 0.35em;
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
    color: var(--blanc);
  }
  .flottant__btn:hover { color: var(--blanc); }
  .flottant__btn--tel { background: var(--rouge); }
  .flottant__btn--whatsapp { background: var(--vert-whatsapp); }
  .flottant__btn--whatsapp:hover { background: var(--vert-whatsapp-fonce); }
  .flottant__btn--devis { background: var(--bleu); }
  .flottant .icone { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }
  .flottant .icone--whatsapp { width: 1rem; height: 1.1rem; }

  @media (max-width: 900px) {
    .flottant { display: flex; }
    /* Évite que la barre masque la fin du contenu */
    :global(body) { padding-bottom: 0; }
  }

  /* Sous 360px, les 3 boutons sont trop serrés avec leur libellé : on ne
     garde le texte que sur le bouton devis (l'action principale). */
  @media (max-width: 360px) {
    .flottant__btn--tel span,
    .flottant__btn--whatsapp span { display: none; }
    .flottant__btn--tel,
    .flottant__btn--whatsapp { flex: 0 0 3.4em; }
    .flottant__btn--devis { flex: 1; }
  }
</style>

<script>
  const barre = document.querySelector('[data-flottant]');
  let tick = false;
  const maj = () => {
    barre?.classList.toggle('flottant--visible', window.scrollY > 400);
    tick = false;
  };
  window.addEventListener('scroll', () => {
    if (tick) return;
    tick = true;
    requestAnimationFrame(maj);
  }, { passive: true });
  maj();
</script>
