---
/**
 * URL conservée : /nettoyage-et-demoussage-de-toiture-dans-le-loiret-45/
 *
 * Le contenu est dans src/data/services-pages.json (entrée « nettoyage » /
 * département 45) et le rendu dans PageService.astro. Les versions
 * Essonne et Loiret de ce service sont deux textes DISTINCTS, rédigés
 * séparément — voir la note en tête de PageService.astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageService from '../components/PageService.astro';
import pages from '../data/services-pages.json';
import { breadcrumb, service as schemaService } from '../lib/schemas';

const page = pages.find((p) => p.cle === 'nettoyage' && p.dept === 45)!;

const extraSchemas = [
  breadcrumb([{ nom: page.filAriane, url: page.url }]),
  schemaService({
    nom: page.h1,
    description: page.meta,
    url: page.url,
    zone: 'Loiret (45)',
  }),
];
---
<BaseLayout title={page.title} description={page.meta} extraSchemas={extraSchemas}>
  <PageService page={page} />
</BaseLayout>
