# ──────────────────────────────────────────────────────────────────
# Variables d'environnement — marvin-ribard.fr
# À configurer sur l'hébergeur au déploiement.
# ⚠️ Ne JAMAIS committer le vrai .env : il contient des secrets.
# ──────────────────────────────────────────────────────────────────

# ── Envoi des emails du formulaire de devis ───────────────────────
# Brevo, API HTTPS (et non SMTP : le port 465/587 sortant est bloqué
# chez la plupart des hébergeurs, le 443 passe partout).
# Clé à créer sur https://app.brevo.com → SMTP & API → Clés API
BREVO_API_KEY=xkeysib-...

# Destinataires de la notification de demande (séparés par des virgules)
ADMIN_EMAILS=monsieur.ribard@gmail.com,jmoog27@gmail.com

# Expéditeur. L'adresse doit être VÉRIFIÉE dans Brevo et le domaine
# authentifié (DKIM + DMARC), sinon les emails partent en spam.
FROM_EMAIL=contact@marvin-ribard.fr
FROM_NAME=Marvin Ribard Couverture - Artisan couvreur

# ── Anti-robot du formulaire ──────────────────────────────────────
# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# La clé SITE est publique (injectée au build dans le HTML).
# La clé SECRET ne quitte jamais le serveur.
# Si ces deux variables sont absentes, le formulaire fonctionne quand
# même : seules les couches honeypot, time-trap et scoring restent.
TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# ── Règles anti-spam centralisées ─────────────────────────────────
# JSON partagé entre tous les sites : ajouter un mot-clé une fois
# suffit, sans rebuild. Si l'URL est absente ou injoignable, le code
# retombe sur les règles intégrées à src/lib/antispam.ts.
SPAM_RULES_URL=https://raw.githubusercontent.com/jmoog/antispam-rules/main/rules.json
SPAM_RULES_TTL=3600
